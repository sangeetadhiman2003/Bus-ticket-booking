<div class="container">

  <div class="booking-details-card">

    <div class="page-header">
      <h1>Booking Details</h1>

      <span class="status-badge">
        <%= @booking.status.humanize %>
      </span>
    </div>

    <div class="booking-route">
      <h2>
        <%= @booking.trip.from_city %>
        →
        <%= @booking.trip.to_city %>
      </h2>
    </div>

    <div class="booking-details">

      <div>
        <span>Operator</span>
        <strong>
          <%= @booking.trip.operator.name %>
        </strong>
      </div>

      <div>
        <span>Seats</span>
        <strong>
          <%= @booking.hold.trip_seats
                .includes(:seat)
                .map { |trip_seat| trip_seat.seat.seat_number }
                .join(", ") %>
        </strong>
      </div>

      <div>
        <span>Number of Seats</span>
        <strong>
          <%= @booking.hold.trip_seats.count %>
        </strong>
      </div>

      <div>
        <span>Departure</span>
        <strong>
          <%= @booking.trip.departure_at.strftime("%d %b %Y, %I:%M %p") %>
        </strong>
      </div>

      <div>
        <span>Arrival</span>
        <strong>
          <%= @booking.trip.arrival_at.strftime("%d %b %Y, %I:%M %p") %>
        </strong>
      </div>

      <div>
        <span>Price per Seat</span>
        <strong>
          ₹<%= @booking.trip.price %>
        </strong>
      </div>

      <div>
        <span>Total Amount</span>
        <strong>
          ₹<%= @booking.total_amount %>
        </strong>
      </div>

    </div>

    <% if @booking.confirmed? %>

      <div class="booking-actions">

          <%= link_to(
          "Reschedule Booking",
          reschedule_booking_path(@booking),
          class: "btn btn-primary"
        ) %>

        <%= button_to(
          "Cancel Booking",
          booking_path(@booking),
          method: :delete,
          class: "btn btn-danger",
          data: {
            turbo_confirm: "Are you sure you want to cancel this booking?"
          }
        ) %>

      </div>

    <% elsif @booking.cancelled? %>

      <div class="refund-details">
        <h3>Booking Cancelled</h3>

        <p>
          This booking has been cancelled.
        </p>
      </div>

    <% end %>

    <div class="back-action">
      <%= link_to(
        "← Back to Trips",
        trips_path,
        class: "btn btn-secondary"
      ) %>
    </div>

  </div>

</div>
